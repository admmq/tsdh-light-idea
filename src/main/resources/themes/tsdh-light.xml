<?xml version="1.0" encoding="UTF-8"?>
<!--
  tsdh-light: an IntelliJ editor color scheme modelled on the tsdh-light
  theme that ships with GNU Emacs (etc/themes/tsdh-light-theme.el, by
  Tassilo Horn).

  Emacs face                       color      used here for
  default                          #383a42    text            on #fafafa
  hl-line, mode-line               #f0f0f1    caret row, completion popup
  region                           #ffec8b    selection (lightgoldenrod1)
  font-lock-keyword-face           #a626a4    keywords
  font-lock-string-face            #50a14f    strings
  font-lock-doc-face               #50a14f i  doc comments / docstrings
  font-lock-comment-face           #a0a1a7    comments
  font-lock-function-name-face     #0184bc    function/method declarations, tags
  font-lock-type-face              #c18401    classes, interfaces, type params
  font-lock-variable-name-face     #8b4513    fields, globals, attributes (saddle brown)
  font-lock-constant-face          #008b8b    constants, annotations, labels (dark cyan)
  font-lock-builtin-face           #e44649    builtins / predefined symbols
  font-lock-escape-face            #000000 b  string escapes
  show-paren-match / -mismatch     #00ffff b / #ff1493 b
  lazy-highlight                   #afeeee    search results
  link / link-visited              #3a5fcd / #8b008b
  error / warning / success        #ff0000 / #ff8c00 / #228b22
  diff-added / -removed / -changed #90ee90 / #f4a460 / #b0c4de

  As in Emacs, numbers, function calls, local variables and parameters
  stay in the default foreground.
-->
